{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# No access log: email verification/reset URLs carry single-use tokens.
	request_body {
		max_size 21MB
	}
	@backend path /api/* /media/* /django-admin /django-admin/* /healthz
	handle @backend {
		reverse_proxy app:8000 {
			# This header is overwritten here, never taken from a public client.
			header_up X-Real-IP {remote_host}
			# Set the scheme explicitly for the deployment mode. Public deployments
			# use https even when another proxy terminates TLS before this Caddy.
			header_up X-Forwarded-Proto {$UPSTREAM_SCHEME}
		}
	}
	handle_path /static/* {
		root * /static
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Internal health probe also works when the public site redirects to HTTPS.
http://:8081 {
	bind 127.0.0.1
	reverse_proxy app:8000 {
		header_up Host localhost
	}
}
