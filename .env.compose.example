# Isolated local Compose demo. Never use your development .env for this stack.
PUBLIC_ORIGIN=http://localhost:8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_ADDRESS=:80
UPSTREAM_SCHEME=http
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Cloud: set PUBLIC_ORIGIN=https://demo.example.com,
# SITE_ADDRESS=demo.example.com, UPSTREAM_SCHEME=https,
# DJANGO_ALLOWED_HOSTS=demo.example.com,localhost,
# BIND_ADDRESS=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443. DNS must point to your server.

# Registration stays closed until real SMTP has been configured and tested.
TIP_ALLOW_REGISTRATION=false
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# Production SMTP: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# Put the SMTP credential in .secrets/smtp_password; never in this env file.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=baicaoyuan@localhost
